# Copy to .env and fill in. cli.py / app.py read these at startup.

# Anthropic API key used for transliteration (Claude Haiku).
# Leave unset to use an `ant auth login` profile instead.
ANTHROPIC_API_KEY=

# Source of Urdu-script transcripts. This is the CPS annotation.db that the
# shukr app also reads (opened READ-ONLY; never written to). On the Hetzner
# box this is /root/annotation_tool_v2/data/annotation.db.
VIDEO_TOOL_SOURCE_DB=/root/annotation_tool_v2/data/annotation.db

# Where this tool keeps its own derived store (Roman Urdu + search index).
# This file is owned by the tool and safe to delete/rebuild.
VIDEO_TOOL_DB=roman.db

# Transliteration model. Haiku is cheap and good enough for this task.
VIDEO_TOOL_MODEL=claude-haiku-4-5
